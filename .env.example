# ==============================================================================
# SIS Cyber Fortress — Environment Configuration Example
# Copy to .env (and apps/api/.env, apps/web/.env.local as needed). Never commit .env!
# ==============================================================================

NODE_ENV=development
APP_NAME="SIS Cyber Fortress"
APP_VERSION=1.0.0

# --- PostgreSQL Database ---
POSTGRES_USER=sis_admin
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=sis_cyber_fortress
DATABASE_URL="postgresql://sis_admin:change_me_strong_db_password@localhost:5432/sis_cyber_fortress?schema=public"

# --- Redis (Optional for queues/caching) ---
REDIS_URL="redis://localhost:6379"

# --- Backend API (NestJS) ---
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
TRUST_PROXY=false

# --- JWT & Session Security (Generate 64+ random hex chars for production!) ---
JWT_ACCESS_SECRET="replace-with-64-char-cryptographically-random-access-secret"
JWT_REFRESH_SECRET="replace-with-64-char-cryptographically-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Demo Seed Data (ONLY enabled explicitly in non-production development) ---
ENABLE_DEMO_SEED=false
DEMO_SUPER_ADMIN_EMAIL=admin@sisfortress.local
DEMO_SUPER_ADMIN_PASSWORD=ChangeMe@2026!

# --- Backup Encryption & Storage ---
BACKUP_STORAGE_DIR=./storage/backups
BACKUP_MASTER_ENVELOPE_KEY="replace-with-32-byte-base64-or-hex-development-key"

# --- Optional External Threat & Breach Providers (Leave blank if offline/local) ---
HIBP_ENABLED=false
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# --- Firebase Cloud Messaging (Optional; leave blank to run local notification store) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Web Application (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=development
API_INTERNAL_URL=http://localhost:4000/api/v1
